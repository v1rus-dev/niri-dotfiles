// -*- mode: jsonc -*-
// Waybar for niri — Tokyo Night Moon, floating islands.
// Adapted from a Hyprland config: hyprland/* -> niri/*, power -> wlogout,
// notifications via swaync, GPU module dropped.
// Docs: https://github.com/Alexays/Waybar/wiki
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  // Match niri `gaps 8`: island outer edge sits 8px from the screen edge.
  // Each island carries a 5px side margin (see style.css), so the bar margin
  // is 3px → 3 + 5 = 8. Top island margin is 0, so margin-top is the full 8.
  "margin-top": 8,
  "margin-left": 3,
  "margin-right": 3,

  "modules-left": ["custom/launcher", "niri/workspaces"],
  "modules-center": [],
  "modules-right": ["group/status", "clock", "custom/power"],

  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "bluetooth",
      "pulseaudio",
      "network",
      "niri/language",
      "idle_inhibitor",
      "group/tray-drawer",
      "custom/notification",
    ],
  },

  "group/tray-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "tray-item",
      "transition-left-to-right": false,
    },
    "modules": ["custom/tray-toggle", "tray"],
  },
  "custom/tray-toggle": {
    "format": "󰅁",
    "tooltip": false,
  },

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "wofi --show drun",
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout",
  },

  // Niri manages workspaces dynamically per-output (no fixed 1..10 like the
  // Hyprland persistent-workspaces). {value} shows the workspace name if named,
  // otherwise its index. Clicking a workspace activates it (module default).
  "niri/workspaces": {
    "all-outputs": false,
    // Scroll over the workspaces island to cycle focus up/down.
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down",
    "format": "{icon}",
    "format-icons": {
      "active": "\uf111", // nf-fa-circle (filled) — current workspace
      "urgent": "\uf111", // nf-fa-circle
      "default": "\uf10c", // nf-fa-circle-o (outline) — other workspaces
    },
  },

  "cpu": {
    "format": "Cpu: {usage}%",
    "tooltip-format": "CPU: {usage}% · load {load}",
    "interval": 5,
    // Colour the readout amber/red past these usage thresholds (see .css).
    "states": { "warning": 70, "critical": 90 },
    "on-click": "kitty -e btop",
  },
  "memory": {
    "format": "Ram: {percentage}%",
    "tooltip-format": "RAM: {used:0.1f}/{total:0.1f} GiB ({percentage}%)",
    "interval": 5,
    "states": { "warning": 75, "critical": 90 },
    "on-click": "kitty -e btop",
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "Temp: {temperatureC}°C",
    "format-icons": ["", "", ""],
    "tooltip-format": "Температура CPU: {temperatureC}°C",
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "", // empty format hides the module (no adapter)
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    // blueman-manager not installed; leaving no on-click (click is a no-op).
  },
  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-bluetooth": "󰕾 {volume}%",
    "format-bluetooth-muted": "󰅶 {icon} {format_source}",
    "format-muted": "󰖁 {volume}%",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "tooltip-format": "{desc}\n{volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕼", "󰕽", "󰕾"],
    },
    // Scroll / right-click route through volume.sh so the bar controls ALL
    // sinks together (speakers + headphones), matching the volume keys.
    "on-scroll-up": "~/.config/niri/scripts/volume.sh up",
    "on-scroll-down": "~/.config/niri/scripts/volume.sh down",
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/niri/scripts/volume.sh mute",
  },
  // Bandwidth lives only in the tooltip now: the live ↓/↑ figures changed
  // width every 2s and resized the whole right island. The bar shows a stable
  // string (essid on wifi, IP on ethernet); hover for live throughput.
  "network": {
    "interval": 2,
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "max-length": 28, // safety cap for long SSIDs
    "tooltip-format": "{ifname} · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "format-linked": "{ifname} (No IP) 󰊗",
    "format-disconnected": "󰖪 Disconnected",
    "on-click": "nm-connection-editor",
  },
  // Niri xkb layout switching (replaces hyprctl switchxkblayout).
  "niri/language": {
    "format": "󰌌 {short}",
    "tooltip-format": "{long}",
    "on-click": "niri msg action switch-layout next",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉",
    },
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂞",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂞",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂜",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
  },
  "clock": {
    "format": "󰥔  {:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}",
  },
}
