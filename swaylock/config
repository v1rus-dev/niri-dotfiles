# swaylock-effects — Tokyo Night
# Effects options (screenshots/effect-*/clock/fade-in) require the
# swaylock-effects fork (AUR: swaylock-effects). Plain swaylock ignores/errors.
# Docs: https://github.com/mortie/swaylock-effects

# --- Behaviour ---
ignore-empty-password
show-failed-attempts
indicator-caps-lock
font=JetBrainsMono Nerd Font

# --- Effects ---
# Background is provided by lock.sh: -i <wallpaper>, or --screenshots as fallback.
# Blur cheaply: downscale -> blur small image -> upscale.
# Order matters (effects apply top-to-bottom). Cuts blur cost ~6x on 2x1440p.
effect-scale=0.4
effect-blur=6x4
effect-scale=2.5
effect-vignette=0.2:0.5
clock
timestr=%H:%M:%S
datestr=%A, %d %B
indicator
indicator-radius=120
indicator-thickness=10
# grace=2   # uncomment to allow a 2s no-password dismiss window after locking

